# ESP-IDF build output
firmware-s3/build/

# Dependencies fetched by the IDF component manager (LVGL, esp_lvgl_port).
# Pinned by firmware/main/idf_component.yml and dependencies.lock.
firmware-s3/managed_components/

# Generated by `idf.py set-target` / menuconfig from sdkconfig.defaults.
# sdkconfig.defaults IS tracked; this generated file is not.
firmware-s3/sdkconfig
firmware-s3/sdkconfig.old

# Host test binaries and their debug bundles
core/test/test_hero_size
core/test/test_font_coverage
core/test/test_layout
*.dSYM/

# Python venv used for font tooling
fontenv/

# macOS
.DS_Store

# Note: core/tools/fonts/RobotoCondensed-Bold.ttf IS tracked -- it is SIL
# OFL and redistributable, and the build needs it to regenerate glyphs.
# Do not vendor non-redistributable system fonts (e.g. Apple's SF family) here.
core/test/test_screens
core/test/test_tapdetect
core/test/test_tapstatus
core/test/test_provision
core/test/test_stripe_key
core/test/test_mrr
core/test/test_format
core/test/test_stripe_parse
core/test/test_freshness
core/test/test_events
core/test/test_rotation
core/test/test_cache

# PlatformIO build output and fetched libraries (arduino/ port)
firmware-c6/.pio/

# Bench credentials, if a secrets.ini is ever reintroduced. Credentials now
# come from the captive portal into NVS, so this should stay unused.
firmware-c6/secrets.ini

