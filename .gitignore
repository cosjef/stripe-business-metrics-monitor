# PlatformIO build output and fetched libraries
firmware-c6/.pio/

# Bench credentials. Provisioning goes through the captive portal into NVS;
# this exists only for a developer who wants to skip that during testing.
firmware-c6/secrets.ini

# Host test binaries and their debug bundles
core/test/test_*
!core/test/test_*.c
core/test/render_docs
core/test/*.ppm
*.dSYM/

# Scratch renders. The README's screenshots in docs/img/ ARE tracked --
# they are generated by core/test/render_docs and are part of the docs.
*.png
!docs/img/*.png

# macOS
.DS_Store

# Note: core/tools/fonts/RobotoCondensed-Bold.ttf IS tracked -- it is SIL OFL
# and redistributable, and gen_fonts.sh needs it to regenerate glyphs.
