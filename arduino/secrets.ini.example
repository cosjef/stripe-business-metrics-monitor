; Bench credentials for the Arduino port. Copy to secrets.ini and fill in.
; secrets.ini is gitignored and must never be committed.
;
; Use a RESTRICTED key (rk_...) with read-only access to subscriptions, not a
; full secret key. The device only ever reads, so a key that can do more than
; read is a liability sitting on a desk.
;
; This is a bench convenience only. Stage 3 replaces it with the captive
; portal, which is where the key belongs in the shipped product -- entered by
; the customer and stored in NVS, never compiled into an image.

[secrets]
wifi_ssid = your-ssid
wifi_pass = your-password
stripe_key = rk_live_or_rk_test_...
